{
  "name": "wonda-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.prod.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/index.js --external:pg --external:bcrypt --external:googleapis --external:express --external:drizzle-orm --external:ical-generator --external:googleapis --external:rrule",
    "build:ci": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "build:server": "esbuild server/index.prod.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/index.js --external:pg --external:bcrypt --external:googleapis",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "@tanstack/react-query": "^5.51.0",
    "zustand": "^4.5.4",
    "express": "^4.19.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "bcrypt": "^5.1.1",
    "pg": "^8.12.0",
    "drizzle-orm": "^0.33.0",
    "dotenv": "^16.4.5",
    "rrule": "^2.8.1",
    "zod": "^3.23.8",
    "googleapis": "^144.0.0",
    "ical-generator": "^7.2.0",
    "recharts": "^2.12.7",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.439.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.6",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "tailwindcss": "^3.4.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.24.2",
    "esbuild": "^0.24.0"
  }
}