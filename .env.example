DATABASE_URL=postgres://wonda:password@localhost:5432/wonda
SESSION_SECRET=replace-with-32-byte-random-string
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-random-string-base64
APP_BASE_URL=http://localhost:5173

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/oauth/callback

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=Wonda Command <noreply@wolfpaqmarketing.com>

# Social — optional, leave empty to keep channels in mock mode
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
